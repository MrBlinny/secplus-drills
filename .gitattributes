# Normalise line endings. LF everywhere, on every platform.
#
# Checked out as LF on Windows too, deliberately: the generators in tools/ write
# LF, so a native-CRLF checkout makes `npm run build-bank` report every
# generated file as modified when nothing has actually changed.
* text=auto eol=lf

# Windows launcher: must keep CRLF or cmd.exe mis-parses it.
*.cmd text eol=crlf

# Shell scripts must keep LF even when checked out on Windows.
*.sh text eol=lf

*.pdf binary
